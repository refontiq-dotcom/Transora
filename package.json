{
  "name": "transora",
  "version": "1.0.0",
  "description": "TRANSORA - Infrastructure SaaS de gestion et d'exploitation pour entreprises de transport interurbain",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node --files src/index.ts",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/app.test.js dist-test/test/db-connection.test.js",
    "lint": "eslint . --ext .ts",
    "db:migrate": "npm run build && node dist/db/migrate.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.13.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "keywords": ["saas", "transport", "multi-tenant", "api-first"],
  "author": "refontiq-dotcom",
  "license": "MIT"
}