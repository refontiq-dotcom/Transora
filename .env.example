PORT=3000
NODE_ENV=development
# Connexion Supabase (le projet génère les deux URLs à partir du mot de passe).
SUPABASE_DB_HOST=your-project.pooler.supabase.com
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_NAME=postgres
SUPABASE_POOLER_TRANSACTION_PORT=6543
SUPABASE_POOLER_SESSION_PORT=5432
SUPABASE_DB_PASSWORD=
SUPABASE_DB_CA_CERT_PATH=certs/prod-ca-2021.crt
# Alternative facultative : définir DATABASE_URL et DIRECT_URL directement.
# Genere un secret aleatoire d'au moins 32 caracteres.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Claims obligatoires des tokens d’accès TRANSORA.
JWT_ISSUER=transora-api
JWT_AUDIENCE=transora-clients

# Origines web autorisées pour les appels navigateur inter-origines (séparées par des virgules).
# Laisser vide pour désactiver le CORS inter-origines.
CORS_ORIGINS=
# Jeton optionnel pour exposer /metrics. Au moins 32 caractères aléatoires.
# Sans ce jeton valide, /metrics répond 404.
METRICS_TOKEN=

# Redis partagé (compatible Upstash Redis REST) pour synchroniser les limites entre instances.
# Définir les deux valeurs pour activer le stockage partagé.
# Si les deux sont absentes, le stockage mémoire local est utilisé.
# Si une seule est définie ou si Redis est indisponible, les routes d'authentification échouent en 503.
REDIS_REST_URL=
REDIS_REST_TOKEN=
